{
    "manifest_version": 3,
    "name": "Mandarin Extension",
    "version": "1.0",
    "description": "Extension for website to help me learn Mandarin",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": ["http://localhost:5000/*"],

    "icons": {
        "32": "icons/icon32.png"
    },

    "action": {},

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "js": ["content_script/content.js"],
            "css": ["content_script/content.css"],
            "matches": ["<all_urls>"]
        }
    ],

    "commands": {
        "reload_extension": {
            "suggested_key": {
                "default": "Ctrl+Shift+O",
                "mac": "Command+Shift+O"
            },
            "description": "Reload extension"
        }
    }
}