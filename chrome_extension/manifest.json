{
    "manifest_version": 3,
    "name": "Mandarin Extension",
    "version": "1.0",
    "description": "Extension for website to help me learn Mandarin",

    "icons": {
        "32": "icons/icon32.png"
    },

    "action": {
        "default_popup": "popup/popup.html"
    },

    "background": {
        "service_worker": "scripts/background.js"
    },

    "content_scripts": [
        {
            "js": ["scripts/content.js"],
            "css": ["styles/content.css"],
            "matches": ["<all_urls>"]
        }
    ]
}