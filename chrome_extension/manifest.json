{
    "manifest_version": 3,
    "name": "Mandarin Extension",
    "version": "1.0",
    "description": "Extension for website to help me learn Mandarin",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": ["http://localhost:5000/*"],

    "icons": {
        "32": "icons/icon32.png"
    },

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "qwertyuiop"
    },

    "background": {
        "service_worker": "scripts/background.js"
    },

    "content_scripts": [
        {
            "js": ["scripts/content.js"],
            "css": ["styles/content.css"],
            "matches": ["<all_urls>"]
        }
    ]
}